{
  "expo": {
    "name": "Durcheap",
    "slug": "durcheap-mobile",
    "description": "Community marketplace with local shopping, event marketing, and seller tools",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#3B82F6",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.durcheap.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses camera for profile pictures and product images",
        "NSMicrophoneUsageDescription": "This app uses microphone for voice search functionality",
        "NSLocationWhenInUseUsageDescription": "This app uses location to show nearby sellers and local delivery options"
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "appStoreUrl": "https://apps.apple.com/app/durcheap/id1234567890"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.durcheap.mobile",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.durcheap.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "durcheap",
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "This app uses location to show nearby sellers and local delivery options."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-project-id-will-be-generated"
      }
    },
    "privacy": "public",
    "githubUrl": "https://github.com/durcheap/mobile-app"
  }
}